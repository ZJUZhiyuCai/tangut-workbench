title: "Tangut Workbench: Source-linked Tangut Lexicography and Manuscript Research"
authors:
  - name: "Tangut Workbench contributors"
version: 0.1.0
date-released: "2026-10-12"
repository-code: "https://github.com/ZJUZhiyuCai/tangut-workbench"
